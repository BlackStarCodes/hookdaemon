# Hookdaemon environment variables.
# Copy to .env and adjust for your environment. Never commit .env.
#
#   cp .env.example .env


# --- Core ---
APP_NAME=hookdaemon
APP_VERSION=0.1.0
ENVIRONMENT=dev
LOG_LEVEL=INFO

# Set LOG_JSON=false for pretty console logs during local development.
LOG_JSON=true

# --- Database (asyncpg driver) ---
# Matches docker-compose's local Postgres service.
DATABASE_URL=postgresql+asyncpg://hookdaemon:hookdaemon@localhost:5432/hookdaemon  # pragma: allowlist secret
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE=1800

# --- API ---
API_STATEMENT_TIMEOUT_MS=10000

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
